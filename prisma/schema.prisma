// Statuses were plain strings, so a typo in a route reached the database and
// only surfaced as a row nothing matched. Each set is closed and named here.
enum ReviewStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum TeamMemberStatus {
  PENDING
  ACTIVE
}

enum MatchStatus {
  SCHEDULED
  PLAYED
}

enum MvpVoteStatus {
  OPEN
  CLOSED
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String             @id @default(cuid())
  phone                 String             @unique
  password              String
  tokenVersion          Int                @default(0)
  // Set when an admin issues a temporary password. Non-null means the current
  // password is temporary: the app is locked until it is changed, and the
  // password stops working altogether once this passes.
  tempPasswordExpiresAt DateTime?
  createdAt             DateTime           @default(now())
  members               Member[]
  pushSubscriptions     PushSubscription[]
  teamFollows           TeamFollow[]
  mvpVotes              MvpVote[]
  quizAssignments       QuizAssignment[]
  quizAttempts          QuizAttempt[]
  currentStreak         Int                @default(0) // consecutive days of app activity ("flame")
  longestStreak         Int                @default(0)
  lastActiveDate        DateTime? // calendar day (UTC) of the last streak-qualifying visit
}

model Member {
  id               String                 @id @default(cuid())
  // One membership per account. Null = admin-added with an unknown phone
  // number, an account attached later; Postgres treats nulls as distinct, so
  // any number of those may sit unattached at once.
  userId           String?                @unique
  user             User?                  @relation(fields: [userId], references: [id])
  fullName         String
  age              String
  paymentMethod    String
  paymentProof     String?
  photo            String?
  paidAmount       Int?
  // How the member wants what they paid above the fee to appear on the
  // support board. Read when the surplus donation is created, never after,
  // so changing it later cannot rewrite a year already published.
  surplusAnonymous Boolean                @default(false)
  referenceCode    String?                @unique // short code the member writes in their bank transfer note, for admin reconciliation
  status           ReviewStatus           @default(PENDING)
  rejectionReason  String? // one of src/lib/rejectionReasons.ts, set on REJECTED, cleared on resubmit/approval
  membershipYear   Int                    @default(dbgenerated("EXTRACT(YEAR FROM now() AT TIME ZONE 'UTC')::INTEGER"))
  memberNumber     String?                @unique
  // What the membership card's QR points at. memberNumber is sequential, so a
  // URL built from it can be counted through; this cannot be guessed.
  verifyToken      String?                @unique
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  registrations    ActivityRegistration[]
  teamMemberships  TeamMember[]
  matchGoals       MatchGoal[]
  matchBookings    MatchBooking[]
  motmMatches      Match[]                @relation("ManOfTheMatch")
  mvpCandidacies   MvpCandidate[]
  donations        Donation[]
  memberships      Membership[]
  payments         Payment[]

  @@index([membershipYear])
}

model Membership {
  id            String   @id @default(cuid())
  memberId      String
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  year          Int
  paidAmount    Int?
  paymentMethod String?
  paymentProof  String?
  recordedBy    String?
  createdAt     DateTime @default(now())

  @@unique([memberId, year])
  @@index([year])
}

model Activity {
  id            String                 @id @default(cuid())
  title         String
  description   String
  period        String? // legacy free text, shown only when startsAt is unset
  startsAt      DateTime? // stored at UTC midnight for an all-day activity; the club sits at UTC+0
  endsAt        DateTime?
  withTime      Boolean                @default(false)
  photo         String?
  capacity      Int?
  isOpen        Boolean                @default(true)
  isTournament  Boolean                @default(false)
  format        TournamentFormat?
  teamSize      Int?
  isVolunteer   Boolean                @default(false) // volunteer campaign (حملة تطوعية) — no in-app registration, "تطوع معنا" links straight to whatsappLink
  whatsappLink  String?
  order         Int                    @default(0) // display order on the public landing page (ascending); admin-controlled
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  registrations ActivityRegistration[]
  teams         Team[]
  matches       Match[]
  groups        Group[]
  expenses      Expense[]
  donations     Donation[]
  admins        AdminActivity[]
  payments      Payment[]
}

model Group {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  name       String
  capacity   Int? // target team count — once reached, the admin UI proposes generating the group-stage schedule
  createdAt  DateTime @default(now())
  teams      Team[]

  @@index([activityId])
}

model Team {
  id          String         @id @default(cuid())
  activityId  String
  activity    Activity       @relation(fields: [activityId], references: [id], onDelete: Cascade)
  groupId     String?
  group       Group?         @relation(fields: [groupId], references: [id], onDelete: SetNull)
  name        String
  autoNamed   Boolean        @default(false)
  logo        String?
  createdAt   DateTime       @default(now())
  members     TeamMember[]
  homeMatches Match[]        @relation("HomeTeam")
  awayMatches Match[]        @relation("AwayTeam")
  goals       MatchGoal[]
  bookings    MatchBooking[]
  followers   TeamFollow[]

  @@index([activityId])
  @@index([groupId])
}

model TeamFollow {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, teamId])
}

model TeamMember {
  id        String           @id @default(cuid())
  teamId    String
  team      Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status    TeamMemberStatus @default(ACTIVE) // PENDING = self-service join awaiting approval, ACTIVE = locked in
  createdAt DateTime         @default(now())

  @@unique([teamId, memberId])
}

model Match {
  id              String         @id @default(cuid())
  activityId      String
  activity        Activity       @relation(fields: [activityId], references: [id], onDelete: Cascade)
  homeTeamId      String
  homeTeam        Team           @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeamId      String
  awayTeam        Team           @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Cascade)
  matchDate       DateTime?
  round           String?
  venue           String?
  order           Int            @default(0)
  isKnockout      Boolean        @default(false)
  bracketRound    Int? // set only for matches created by the bracket generator (round 1 = first knockout round, increasing towards the final)
  homeScore       Int?
  awayScore       Int?
  homePenalties   Int?
  awayPenalties   Int?
  manOfTheMatchId String?
  manOfTheMatch   Member?        @relation("ManOfTheMatch", fields: [manOfTheMatchId], references: [id], onDelete: SetNull)
  status          MatchStatus    @default(SCHEDULED)
  reminderSentAt  DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  goals           MatchGoal[]
  bookings        MatchBooking[]
  mvpVote         MatchMvpVote?

  @@index([activityId])
}

model MatchMvpVote {
  id         String         @id @default(cuid())
  matchId    String         @unique
  match      Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  status     MvpVoteStatus  @default(OPEN)
  createdAt  DateTime       @default(now())
  closedAt   DateTime?
  candidates MvpCandidate[]
  votes      MvpVote[]
}

model MvpCandidate {
  id       String       @id @default(cuid())
  voteId   String
  vote     MatchMvpVote @relation(fields: [voteId], references: [id], onDelete: Cascade)
  memberId String
  member   Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  votes    MvpVote[]

  @@unique([voteId, memberId])
}

model MvpVote {
  id          String       @id @default(cuid())
  voteId      String
  vote        MatchMvpVote @relation(fields: [voteId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   MvpCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())

  @@unique([voteId, userId])
  @@index([candidateId])
}

model MatchBooking {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  cardType  String
  minute    Int?
  createdAt DateTime @default(now())

  @@index([matchId])
}

model MatchGoal {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  count     Int      @default(1)
  minute    Int?
  createdAt DateTime @default(now())

  @@index([matchId])
}

model ActivityRegistration {
  id              String       @id @default(cuid())
  memberId        String
  member          Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  activityId      String
  activity        Activity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  status          ReviewStatus @default(PENDING)
  paymentProof    String?
  rejectionReason String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([memberId, activityId])
  @@index([activityId])
}

model Admin {
  id           String          @id @default(cuid())
  username     String          @unique
  password     String
  role         String          @default("SUPER")
  tokenVersion Int             @default(0)
  lastLoginAt  DateTime?
  lastLoginIp  String?
  createdAt    DateTime        @default(now())
  activities   AdminActivity[]
}

model AdminActivity {
  id         String   @id @default(cuid())
  adminId    String
  admin      Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([adminId, activityId])
  @@index([activityId])
}

model Counter {
  id    String @id
  value Int    @default(0)
}

// Admin-managed list of "عصر" (age-group/cohort) names offered when adding
// or editing a Member. Member.age holds a copy of the name rather than a
// foreign key, so renaming an entry rewrites every member carrying the old
// name in the same transaction. Deleting one leaves those members alone.
model AgeGroup {
  id         String   @id @default(cuid())
  name       String   @unique
  totalCount Int      @default(30)
  createdAt  DateTime @default(now())
}

model Donation {
  id             String       @id @default(cuid())
  donorName      String? // null = anonymous ("فاعل خير" in the UI) — even when memberId is set (a member chose to stay anonymous)
  donorPhone     String? // recorded for manually-entered donors with no app account, or as a general contact note
  donorPhoto     String? // photo for a donor with no linked Member (manually-entered) — shown on the public leaderboard
  amount         Int?
  proof          String? // null for MEMBERSHIP-source donations from members with no tracked payment proof
  status         ReviewStatus @default(PENDING) // MEMBERSHIP-source rows are always created ACTIVE
  source         String       @default("PUBLIC") // PUBLIC (anonymous, no account) | SELF (logged-in member) | MEMBERSHIP (auto membership surplus)
  paymentMethod  String? // بنكيلي | السداد | مصرفي | نقداً — set manually by admin (proof screenshots aren't parsed automatically)
  memberId       String?
  member         Member?      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  membershipYear Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  tags           FinanceTag[]
  activityId     String?
  activity       Activity?    @relation(fields: [activityId], references: [id], onDelete: SetNull)

  @@index([memberId])
  @@index([status])
  @@index([activityId])
}

// Manually-entered outgoing spending (association expenses) — no in-app
// source generates these; an admin logs and edits every row by hand.
model Expense {
  id         String       @id @default(cuid())
  label      String
  amount     Int
  note       String?
  proof      String? // optional receipt/invoice image — served via the admin-only /api/files/[filename] route
  date       DateTime     @default(now()) // when the money was spent (admin-editable, distinct from createdAt)
  createdBy  String // admin username, plain string like AuditLog.adminUsername — not a relation
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  tags       FinanceTag[]
  activityId String?
  activity   Activity?    @relation(fields: [activityId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([activityId])
}

// What the money was for, as a list an admin keeps rather than free text, so
// spending can be totalled by tag. Many per expense: one payment can be both
// transport and a tournament.
model FinanceTag {
  id        String     @id @default(cuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  expenses  Expense[]
  donations Donation[]
}

// One row per (day, anonymous visitor) — the visitor cookie is set by
// /api/track-visit and never tied to a User/Member/Admin. pageViews counts
// repeat navigations within the same day for that visitor; the row count
// per day is the daily unique-visitor count.
// The fingerprint of a stored proof image, keyed by the filename the records
// point at. One table rather than a column per model: Member.paymentProof,
// Donation.proof and Expense.proof all hold a filename, so "who else sent
// this exact image" is one query instead of three.
model ProofImage {
  filename  String   @id
  sha256    String
  createdAt DateTime @default(now())

  @@index([sha256])
}

model SiteVisit {
  id        String   @id @default(cuid())
  date      String // YYYY-MM-DD (UTC day bucket)
  visitorId String // anonymous cookie value, no PII
  pageViews Int      @default(1)
  lastSeen  DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([date, visitorId])
  @@index([date])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model AuditLog {
  id            String   @id @default(cuid())
  adminUsername String
  action        String
  targetLabel   String?
  createdAt     DateTime @default(now())

  // Everything below is optional on purpose: rows written before these
  // existed still have to render in the log viewer.
  adminId    String?
  adminRole  String?
  targetType String?
  targetId   String?
  before     Json?
  after      Json?
  meta       Json?
  ip         String?
  userAgent  String?

  @@index([createdAt])
  @@index([targetType, targetId])
}

model QuizQuestion {
  id           String              @id @default(cuid())
  text         String
  category     String // free-text, admin-typed (e.g. "تاريخ", "رياضة")
  points       Int                 @default(10)
  correctCount Int                 @default(1) // number of answers that must be selected to earn credit
  active       Boolean             @default(true) // soft-disable without losing send history
  createdBy    String // admin username
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  answers      QuizAnswer[]
  assignments  QuizAssignment[]
  dayEntries   QuizDayQuestion[]
  attemptRows  QuizAttemptAnswer[]

  @@index([active])
}

model QuizAnswer {
  id         String       @id @default(cuid())
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean      @default(false)
  order      Int          @default(0)

  @@index([questionId])
}

// One row = one question sent to one user. The unique constraint is what
// guarantees a user never receives the same question twice, in either send
// mode. batchId groups the rows created by a single send action (manual
// SAME/RANDOM or the daily auto-send) for admin reporting.
model QuizAssignment {
  id                String       @id @default(cuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId        String
  question          QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  batchId           String
  mode              String // "SAME" | "RANDOM"
  sentAt            DateTime     @default(now())
  revealedAt        DateTime?
  answeredAt        DateTime?
  selectedAnswerIds String[]     @default([])
  isCorrect         Boolean?
  pointsAwarded     Int          @default(0)

  @@unique([userId, questionId])
  @@index([userId])
  @@index([batchId])
}

// Singleton row (id fixed to "singleton", same idiom as Counter) holding the
// quiz's global defaults plus the daily auto-send marker.
model QuizSettings {
  id                  String    @id
  defaultAnswerCount  Int       @default(4)
  defaultCorrectCount Int       @default(1)
  defaultPoints       Int       @default(10)
  questionsPerDay     Int       @default(1)
  answerWindowSeconds Int       @default(10)
  minScorePercent     Int       @default(40)
  lastAutoSendDate    DateTime?
  updatedAt           DateTime  @updatedAt
}

// Singleton row (id fixed to "singleton", same idiom as QuizSettings) holding
// the values the association decides rather than the developer: the fee, the
// contact number members are sent to. Changing one shouldn't need a deploy.
model AppSettings {
  id                String   @id
  membershipFee     Int      @default(100)
  membershipYear    Int?
  supportWhatsapp   String   @default("22241070328")
  tempPasswordHours Int      @default(1)
  whatsappGroup     String?
  updatedAt         DateTime @updatedAt
}

model DeletedRecord {
  id        String   @id @default(cuid())
  kind      String
  recordId  String
  label     String
  data      Json
  deletedBy String
  deletedAt DateTime @default(now())
  expiresAt DateTime

  @@index([kind])
  @@index([expiresAt])
}

model Competition {
  id                 String    @id @default(cuid())
  name               String
  startsOn           String
  days               Int       @default(30)
  publishMinutes     Int       @default(480)
  cutoffMinutes      Int       @default(1320)
  servedCount        Int       @default(10)
  poolSize           Int       @default(30)
  weeklyCountingDays Int       @default(6)
  speedBands         Json
  quizDays           QuizDay[]
  startedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model QuizDay {
  id            String            @id @default(cuid())
  competitionId String
  competition   Competition       @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  day           String
  createdAt     DateTime          @default(now())
  questions     QuizDayQuestion[]
  attempts      QuizAttempt[]

  @@unique([competitionId, day])
  @@index([day])
}

model QuizDayQuestion {
  id         String       @id @default(cuid())
  dayId      String
  quizDay    QuizDay      @relation(fields: [dayId], references: [id], onDelete: Cascade)
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([dayId, questionId])
  @@index([dayId])
}

model QuizAttempt {
  id         String              @id @default(cuid())
  dayId      String
  quizDay    QuizDay             @relation(fields: [dayId], references: [id], onDelete: Cascade)
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt  DateTime            @default(now())
  finishedAt DateTime?
  score      Int                 @default(0)
  answers    QuizAttemptAnswer[]

  @@unique([dayId, userId])
  @@index([userId])
}

model QuizAttemptAnswer {
  id                String       @id @default(cuid())
  attemptId         String
  attempt           QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId        String
  question          QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  position          Int
  optionOrder       String[]     @default([])
  shownAt           DateTime?
  answeredAt        DateTime?
  selectedAnswerIds String[]     @default([])
  isCorrect         Boolean?
  elapsedMs         Int?
  points            Int          @default(0)

  @@unique([attemptId, position])
  @@index([attemptId])
}

enum PaymentPurpose {
  MEMBERSHIP
  DONATION
  ACTIVITY
}

model Payment {
  id         String         @id @default(cuid())
  purpose    PaymentPurpose
  amount     Int
  feeApplied Int?
  year       Int?
  method     String?
  proof      String?
  status     ReviewStatus   @default(PENDING)
  anonymous  Boolean        @default(false)
  donorName  String?
  memberId   String?
  member     Member?        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  activityId String?
  activity   Activity?      @relation(fields: [activityId], references: [id], onDelete: SetNull)
  recordedBy String?
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([memberId, year, purpose])
  @@index([status])
  @@index([activityId])
}

enum TournamentFormat {
  KNOCKOUT
  GROUPS_THEN_KNOCKOUT
}
