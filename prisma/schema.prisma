generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id @default(cuid())
  phone             String             @unique
  password          String
  tokenVersion      Int                @default(0)
  createdAt         DateTime           @default(now())
  members           Member[]
  pushSubscriptions PushSubscription[]
  teamFollows       TeamFollow[]
  mvpVotes          MvpVote[]
}

model Member {
  id              String                 @id @default(cuid())
  userId          String
  user            User                   @relation(fields: [userId], references: [id])
  fullName        String
  phone           String
  age             String
  paymentMethod   String
  paymentProof    String?
  photo           String?
  paidAmount      Int?
  status          String                 @default("PENDING")
  memberNumber    String?                @unique
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  registrations   ActivityRegistration[]
  teamMemberships TeamMember[]
  matchGoals      MatchGoal[]
  matchBookings   MatchBooking[]
  motmMatches     Match[]                @relation("ManOfTheMatch")
  mvpCandidacies  MvpCandidate[]
  donations       Donation[]
}

model Activity {
  id            String                 @id @default(cuid())
  title         String
  description   String
  period        String?
  photo         String?
  capacity      Int?
  isOpen        Boolean                @default(true)
  isTournament  Boolean                @default(false)
  isVolunteer   Boolean                @default(false) // volunteer campaign (حملة تطوعية) — no in-app registration, "تطوع معنا" links straight to whatsappLink
  whatsappLink  String?
  order         Int                    @default(0) // display order on the public landing page (ascending); admin-controlled
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  registrations ActivityRegistration[]
  teams         Team[]
  matches       Match[]
  groups        Group[]
}

model Group {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  name       String
  capacity   Int? // target team count — once reached, the admin UI proposes generating the group-stage schedule
  createdAt  DateTime @default(now())
  teams      Team[]

  @@index([activityId])
}

model Team {
  id          String         @id @default(cuid())
  activityId  String
  activity    Activity       @relation(fields: [activityId], references: [id], onDelete: Cascade)
  groupId     String?
  group       Group?         @relation(fields: [groupId], references: [id], onDelete: SetNull)
  name        String
  logo        String?
  createdAt   DateTime       @default(now())
  members     TeamMember[]
  homeMatches Match[]        @relation("HomeTeam")
  awayMatches Match[]        @relation("AwayTeam")
  goals       MatchGoal[]
  bookings    MatchBooking[]
  followers   TeamFollow[]

  @@index([activityId])
  @@index([groupId])
}

model TeamFollow {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, teamId])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status    String   @default("ACTIVE") // "PENDING" (self-service join, awaiting admin approval) | "ACTIVE" (locked in)
  createdAt DateTime @default(now())

  @@unique([teamId, memberId])
}

model Match {
  id              String         @id @default(cuid())
  activityId      String
  activity        Activity       @relation(fields: [activityId], references: [id], onDelete: Cascade)
  homeTeamId      String
  homeTeam        Team           @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeamId      String
  awayTeam        Team           @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Cascade)
  matchDate       DateTime?
  round           String?
  venue           String?
  order           Int            @default(0)
  isKnockout      Boolean        @default(false)
  bracketRound    Int? // set only for matches created by the bracket generator (round 1 = first knockout round, increasing towards the final)
  homeScore       Int?
  awayScore       Int?
  homePenalties   Int?
  awayPenalties   Int?
  manOfTheMatchId String?
  manOfTheMatch   Member?        @relation("ManOfTheMatch", fields: [manOfTheMatchId], references: [id], onDelete: SetNull)
  status          String         @default("SCHEDULED")
  reminderSentAt  DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  goals           MatchGoal[]
  bookings        MatchBooking[]
  mvpVote         MatchMvpVote?

  @@index([activityId])
}

model MatchMvpVote {
  id         String         @id @default(cuid())
  matchId    String         @unique
  match      Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  status     String         @default("OPEN")
  createdAt  DateTime       @default(now())
  closedAt   DateTime?
  candidates MvpCandidate[]
  votes      MvpVote[]
}

model MvpCandidate {
  id       String       @id @default(cuid())
  voteId   String
  vote     MatchMvpVote @relation(fields: [voteId], references: [id], onDelete: Cascade)
  memberId String
  member   Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  votes    MvpVote[]

  @@unique([voteId, memberId])
}

model MvpVote {
  id          String       @id @default(cuid())
  voteId      String
  vote        MatchMvpVote @relation(fields: [voteId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   MvpCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())

  @@unique([voteId, userId])
  @@index([candidateId])
}

model MatchBooking {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  cardType  String
  minute    Int?
  createdAt DateTime @default(now())

  @@index([matchId])
}

model MatchGoal {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  count     Int      @default(1)
  minute    Int?
  createdAt DateTime @default(now())

  @@index([matchId])
}

model ActivityRegistration {
  id              String   @id @default(cuid())
  memberId        String
  member          Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  activityId      String
  activity        Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  status          String   @default("PENDING")
  paymentProof    String?
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([memberId, activityId])
  @@index([activityId])
}

model Admin {
  id           String    @id @default(cuid())
  username     String    @unique
  password     String
  role         String    @default("SUPER")
  tokenVersion Int       @default(0)
  lastLoginAt  DateTime?
  lastLoginIp  String?
  createdAt    DateTime  @default(now())
}

model Counter {
  id    String @id
  value Int    @default(0)
}

model Donation {
  id            String   @id @default(cuid())
  donorName     String? // null = anonymous ("فاعل خير" in the UI) — even when memberId is set (a member chose to stay anonymous)
  donorPhone    String? // recorded for manually-entered donors with no app account, or as a general contact note
  donorPhoto    String? // photo for a donor with no linked Member (manually-entered) — shown on the public leaderboard
  amount        Int?
  proof         String? // null for MEMBERSHIP-source donations from members with no tracked payment proof
  status        String   @default("PENDING") // PENDING | ACTIVE | REJECTED — MEMBERSHIP-source rows are always created ACTIVE
  source        String   @default("PUBLIC") // PUBLIC (anonymous, no account) | SELF (logged-in member) | MEMBERSHIP (auto membership surplus)
  paymentMethod String? // بنكيلي | السداد | مصرفي | نقداً — set manually by admin (proof screenshots aren't parsed automatically)
  memberId      String?
  member        Member?  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([memberId])
  @@index([status])
}

// Manually-entered outgoing spending (association expenses) — no in-app
// source generates these; an admin logs and edits every row by hand.
model Expense {
  id        String   @id @default(cuid())
  label     String
  amount    Int
  note      String?
  proof     String? // optional receipt/invoice image — served via the admin-only /api/files/[filename] route
  date      DateTime @default(now()) // when the money was spent (admin-editable, distinct from createdAt)
  createdBy String // admin username, plain string like AuditLog.adminUsername — not a relation
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model AuditLog {
  id            String   @id @default(cuid())
  adminUsername String
  action        String
  targetLabel   String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
}
