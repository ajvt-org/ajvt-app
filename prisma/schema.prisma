// Statuses were plain strings, so a typo in a route reached the database and
// only surfaced as a row nothing matched. Each set is closed and named here.
enum ReviewStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum TeamMemberStatus {
  PENDING
  ACTIVE
}

enum MatchStatus {
  SCHEDULED
  PLAYED
}

enum MvpVoteStatus {
  OPEN
  CLOSED
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                   @id @default(cuid())
  phone                   String?                  @unique
  password                String?
  tokenVersion            Int                      @default(0)
  // Set when an admin issues a temporary password. Non-null means the current
  // password is temporary: the app is locked until it is changed, and the
  // password stops working altogether once this passes.
  tempPasswordExpiresAt   DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  fullName                String?
  age                     String?
  village                 String                   @default("التاكلالت")
  photo                   String?
  photoLocked             Boolean                  @default(false)
  supportNameConfidential Boolean                  @default(false)
  memberNumber            String?                  @unique
  verifyToken             String?                  @unique
  registrations           ActivityRegistration[]
  teamMemberships         TeamMember[]
  matchGoals              MatchGoal[]
  penaltyKicks            MatchPenaltyKick[]
  matchBookings           MatchBooking[]
  motmMatches             Match[]                  @relation("ManOfTheMatchUser")
  mvpCandidacies          MvpCandidate[]
  donations               Donation[]
  memberships             Membership[]
  payments                Payment[]
  suspensions             Suspension[]
  receipts                Receipt[]
  pushSubscriptions       PushSubscription[]
  notificationPrefs       NotificationPreference[]
  teamFollows             TeamFollow[]
  captainOf               Team[]                   @relation("TeamCaptain")
  mvpVotes                MvpVote[]
  quizAttempts            QuizAttempt[]
  quizParticipations      QuizParticipant[]
  currentStreak           Int                      @default(0) // consecutive days of app activity ("flame")
  longestStreak           Int                      @default(0)
  lastActiveDate          DateTime? // calendar day (UTC) of the last streak-qualifying visit
}

model Membership {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  year            Int
  status          ReviewStatus    @default(PENDING)
  rejectionReason String?
  paymentMethod   String?
  accountId       String?
  bankReference   String?
  account         PaymentAccount? @relation(fields: [accountId], references: [id], onDelete: Restrict)
  paymentProof    String?
  referenceCode   String?         @unique
  recordedBy      String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([userId, year])
  @@index([year])
  @@index([status])
  @@index([accountId])
  @@index([bankReference])
}

model Activity {
  id                  String                 @id @default(cuid())
  title               String
  description         String
  period              String? // legacy free text, shown only when startsAt is unset
  startsAt            DateTime? // stored at UTC midnight for an all-day activity; the club sits at UTC+0
  endsAt              DateTime?
  withTime            Boolean                @default(false)
  photo               String?
  capacity            Int?
  isOpen              Boolean                @default(true)
  autoApprove         Boolean                @default(false)
  isTournament        Boolean                @default(false)
  format              TournamentFormat?
  profile             SportProfile           @default(FOOTBALL)
  teamSize            Int?
  yellowsForBan       Int                    @default(2) // yellows across the tournament that propose a suspension
  redBanMatches       Int                    @default(1) // matches a proposed red-card ban carries
  showScorersAndCards Boolean                @default(true) // public match cards list the scorers and the red cards; the man of the match and the timeline stay either way
  published           Boolean                @default(true)
  mvpVoteMinutes      Int                    @default(120) // how long a man-of-the-match vote stays open, per match, adjustable when it is opened
  isVolunteer         Boolean                @default(false) // volunteer campaign (حملة تطوعية) — no in-app registration, "تطوع معنا" links straight to whatsappLink
  whatsappLink        String?
  order               Int                    @default(0) // display order on the public landing page (ascending); admin-controlled
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  registrations       ActivityRegistration[]
  teams               Team[]
  matches             Match[]
  groups              Group[]
  expenses            Expense[]
  expenseAllocations  ExpenseAllocation[]
  donations           Donation[]
  admins              AdminActivity[]
  payments            Payment[]
  days                TournamentDay[]
  suspensions         Suspension[]
}

// The tournament's spine: an ordered run of days counted from the activity's
// startsAt. position is 1-based and dense; a day's date is startsAt plus
// position minus one, so inserting a rest day shifts everything after it by
// renumbering, and endsAt is always the last position's date.
model TournamentDay {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  position   Int
  isRest     Boolean  @default(false)
  createdAt  DateTime @default(now())
  matches    Match[]

  @@unique([activityId, position])
}

model Group {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  name       String
  capacity   Int? // target team count — once reached, the admin UI proposes generating the group-stage schedule
  createdAt  DateTime @default(now())
  teams      Team[]

  @@index([activityId])
}

model Team {
  id            String                 @id @default(cuid())
  activityId    String
  activity      Activity               @relation(fields: [activityId], references: [id], onDelete: Cascade)
  groupId       String?
  group         Group?                 @relation(fields: [groupId], references: [id], onDelete: SetNull)
  name          String
  autoNamed     Boolean                @default(false)
  logo          String?
  captainUserId String?
  captain       User?                  @relation("TeamCaptain", fields: [captainUserId], references: [id], onDelete: SetNull)
  createdAt     DateTime               @default(now())
  members       TeamMember[]
  homeMatches   Match[]                @relation("HomeTeam")
  awayMatches   Match[]                @relation("AwayTeam")
  forfeitWins   Match[]                @relation("ForfeitWinner")
  goals         MatchGoal[]
  bookings      MatchBooking[]
  penaltyKicks  MatchPenaltyKick[]
  followers     TeamFollow[]
  chosenBy      ActivityRegistration[] @relation("ChosenTeam")

  @@index([activityId])
  @@index([groupId])
  @@index([captainUserId])
}

model TeamFollow {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, teamId])
}

model TeamMember {
  id        String           @id @default(cuid())
  teamId    String
  team      Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    TeamMemberStatus @default(ACTIVE) // PENDING = self-service join awaiting approval, ACTIVE = locked in
  createdAt DateTime         @default(now())

  @@unique([teamId, userId])
}

model Match {
  id                  String             @id @default(cuid())
  activityId          String
  activity            Activity           @relation(fields: [activityId], references: [id], onDelete: Cascade)
  homeTeamId          String?
  homeTeam            Team?              @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeamId          String?
  awayTeam            Team?              @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Cascade)
  matchDate           DateTime?
  dayId               String?
  day                 TournamentDay?     @relation(fields: [dayId], references: [id], onDelete: SetNull)
  round               String?
  venue               String?
  order               Int                @default(0)
  isKnockout          Boolean            @default(false)
  bracketRound        Int?
  homeScore           Int?
  awayScore           Int?
  homePenalties       Int?
  awayPenalties       Int?
  manOfTheMatchUserId String?
  manOfTheMatchUser   User?              @relation("ManOfTheMatchUser", fields: [manOfTheMatchUserId], references: [id], onDelete: SetNull)
  forfeitWinnerTeamId String?
  forfeitWinnerTeam   Team?              @relation("ForfeitWinner", fields: [forfeitWinnerTeamId], references: [id], onDelete: SetNull)
  status              MatchStatus        @default(SCHEDULED)
  suspensionsServedAt DateTime?
  reminderSentAt      DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  goals               MatchGoal[]
  bookings            MatchBooking[]
  penaltyKicks        MatchPenaltyKick[]
  mvpVote             MatchMvpVote?

  @@index([activityId])
  @@index([forfeitWinnerTeamId])
}

model MatchMvpVote {
  id         String         @id @default(cuid())
  matchId    String         @unique
  match      Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  status     MvpVoteStatus  @default(OPEN)
  createdAt  DateTime       @default(now())
  closesAt   DateTime
  closedAt   DateTime?
  candidates MvpCandidate[]
  votes      MvpVote[]
}

model MvpCandidate {
  id     String       @id @default(cuid())
  voteId String
  vote   MatchMvpVote @relation(fields: [voteId], references: [id], onDelete: Cascade)
  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes  MvpVote[]

  @@unique([voteId, userId])
}

model MvpVote {
  id          String       @id @default(cuid())
  voteId      String
  vote        MatchMvpVote @relation(fields: [voteId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   MvpCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())

  @@unique([voteId, userId])
  @@index([candidateId])
}

model MatchBooking {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  cardType  String
  minute    Int?
  createdAt DateTime @default(now())

  @@index([matchId])
}

enum GoalKind {
  GOAL
  PENALTY
  OWN_GOAL
}

enum GoalPeriod {
  REGULAR
  EXTRA_TIME
}

// teamId is the team the goal counts FOR. A null member is an unknown scorer;
// an OWN_GOAL's member belongs to the other team. Scores derive from these
// rows when a result is saved with events.
model MatchGoal {
  id        String     @id @default(cuid())
  matchId   String
  match     Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  count     Int        @default(1)
  minute    Int?
  kind      GoalKind   @default(GOAL)
  period    GoalPeriod @default(REGULAR)
  createdAt DateTime   @default(now())

  @@index([matchId])
}

model MatchPenaltyKick {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     Int
  scored    Boolean
  createdAt DateTime @default(now())

  @@unique([matchId, order])
}

enum RegistrationSource {
  SELF
  ADMIN
}

model ActivityRegistration {
  id              String              @id @default(cuid())
  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId      String
  activity        Activity            @relation(fields: [activityId], references: [id], onDelete: Cascade)
  status          ReviewStatus        @default(PENDING)
  paymentProof    String?
  rejectionReason String?
  source          RegistrationSource?
  recordedBy      String?
  chosenTeamId    String?
  chosenTeam      Team?               @relation("ChosenTeam", fields: [chosenTeamId], references: [id], onDelete: SetNull)
  teamNudgeSentAt DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([userId, activityId])
  @@index([activityId])
  @@index([chosenTeamId])
}

model Admin {
  id           String          @id @default(cuid())
  username     String          @unique
  password     String
  role         String          @default("SUPER")
  tokenVersion Int             @default(0)
  lastLoginAt  DateTime?
  lastLoginIp  String?
  createdAt    DateTime        @default(now())
  activities   AdminActivity[]
}

model AdminActivity {
  id         String   @id @default(cuid())
  adminId    String
  admin      Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([adminId, activityId])
  @@index([activityId])
}

model Counter {
  id    String @id
  value Int    @default(0)
}

// Admin-managed list of "عصر" (age-group/cohort) names offered when adding
// or editing a Member. Member.age holds a copy of the name rather than a
// foreign key, so renaming an entry rewrites every member carrying the old
// name in the same transaction. Deleting one leaves those members alone.
model AgeGroup {
  id         String   @id @default(cuid())
  name       String   @unique
  totalCount Int      @default(30)
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Village {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model Donation {
  id             String          @id @default(cuid())
  // Whether the giver asked to stay unnamed. Read on its own: donorName is
  // kept so an admin can still see who gave.
  anonymous      Boolean         @default(false)
  donorName      String? // the name on the gift — typed by hand, or taken from the account the moment one is linked
  donorPhone     String? // recorded for manually-entered donors with no app account, or as a general contact note
  donorPhoto     String? // photo for a donor with no linked Member (manually-entered) — shown on the public leaderboard
  amount         Int?
  proof          String? // null for MEMBERSHIP-source donations from members with no tracked payment proof
  status         ReviewStatus    @default(PENDING) // MEMBERSHIP-source rows are always created ACTIVE
  source         String          @default("PUBLIC") // PUBLIC (anonymous, no account) | SELF (logged-in member) | MEMBERSHIP (auto membership surplus)
  paymentMethod  String?
  accountId      String?
  bankReference  String?
  account        PaymentAccount? @relation(fields: [accountId], references: [id], onDelete: Restrict)
  userId         String?
  user           User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  membershipYear Int?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tags           FinanceTag[]
  activityId     String?
  activity       Activity?       @relation(fields: [activityId], references: [id], onDelete: SetNull)
  competitionId  String?
  competition    Competition?    @relation(fields: [competitionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([activityId])
  @@index([competitionId])
  @@index([accountId])
  @@index([bankReference])
}

model Expense {
  id            String              @id @default(cuid())
  label         String
  amount        Int
  method        String?
  accountId     String?
  account       PaymentAccount?     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  note          String?
  proof         String?
  date          DateTime            @default(now())
  createdBy     String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  tags          FinanceTag[]
  proofs        ExpenseProof[]
  allocations   ExpenseAllocation[]
  activityId    String?
  activity      Activity?           @relation(fields: [activityId], references: [id], onDelete: SetNull)
  competitionId String?
  competition   Competition?        @relation(fields: [competitionId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([activityId])
  @@index([competitionId])
  @@index([accountId])
}

model ExpenseAllocation {
  id            String       @id @default(cuid())
  expenseId     String
  expense       Expense      @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  amount        Int
  activityId    String?
  activity      Activity?    @relation(fields: [activityId], references: [id], onDelete: SetNull)
  competitionId String?
  competition   Competition? @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())

  @@index([expenseId])
  @@index([activityId])
  @@index([competitionId])
}

model ExpenseProof {
  id        String   @id @default(cuid())
  expenseId String
  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  filename  String
  createdAt DateTime @default(now())

  @@unique([expenseId, filename])
  @@index([expenseId])
  @@index([filename])
}

// What the money was for, as a list an admin keeps rather than free text, so
// spending can be totalled by tag. Many per expense: one payment can be both
// transport and a tournament.
model FinanceTag {
  id        String     @id @default(cuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  expenses  Expense[]
  donations Donation[]
  payments  Payment[]
}

model PaymentMethod {
  id           String           @id @default(cuid())
  name         String           @unique
  memberFacing Boolean          @default(false)
  active       Boolean          @default(true)
  position     Int
  accounts     PaymentAccount[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([active, position])
}

model PaymentAccount {
  id        String        @id @default(cuid())
  methodId  String
  method    PaymentMethod @relation(fields: [methodId], references: [id], onDelete: Restrict)
  code      String
  label     String?
  position  Int
  active    Boolean       @default(true)
  openedAt  DateTime      @default(now())
  closedAt  DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  payments    Payment[]
  memberships Membership[]
  donations   Donation[]
  expenses    Expense[]

  @@unique([methodId, code])
  @@index([methodId, active])
}

// One row per (day, anonymous visitor) — the visitor cookie is set by
// /api/track-visit and never tied to a User/Member/Admin. pageViews counts
// repeat navigations within the same day for that visitor; the row count
// per day is the daily unique-visitor count.
// The fingerprint of a stored proof image, keyed by the filename the records
// point at. One table rather than a column per model: Member.paymentProof,
// Donation.proof and Expense.proof all hold a filename, so "who else sent
// this exact image" is one query instead of three.
model ProofImage {
  filename  String   @id
  sha256    String
  createdAt DateTime @default(now())

  @@index([sha256])
}

model SiteVisit {
  id        String   @id @default(cuid())
  date      String // YYYY-MM-DD (UTC day bucket)
  visitorId String // anonymous cookie value, no PII
  pageViews Int      @default(1)
  lastSeen  DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([date, visitorId])
  @@index([date])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  enabled   Boolean
  updatedAt DateTime @updatedAt

  @@unique([userId, category])
  @@index([userId])
}

model AuditLog {
  id            String   @id @default(cuid())
  adminUsername String
  action        String
  targetLabel   String?
  createdAt     DateTime @default(now())

  // Everything below is optional on purpose: rows written before these
  // existed still have to render in the log viewer.
  adminId    String?
  adminRole  String?
  targetType String?
  targetId   String?
  before     Json?
  after      Json?
  meta       Json?
  ip         String?
  userAgent  String?

  @@index([createdAt])
  @@index([targetType, targetId])
}

// A named pile of questions. A quiz draws from exactly one, so two quizzes can
// be about different things without keeping their questions apart by hand.
model QuestionBank {
  id           String         @id @default(cuid())
  name         String         @unique
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  questions    QuizQuestion[]
  competitions Competition[]
}

model QuizQuestion {
  id           String              @id @default(cuid())
  text         String
  category     String // free-text, admin-typed (e.g. "تاريخ", "رياضة")
  points       Int                 @default(10)
  correctCount Int                 @default(1) // number of answers that must be selected to earn credit
  bankId       String              @default("general")
  bank         QuestionBank        @relation(fields: [bankId], references: [id])
  active       Boolean             @default(true) // soft-disable without losing send history
  createdBy    String // admin username
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  answers      QuizAnswer[]
  roundEntries QuizRoundQuestion[]
  attemptRows  QuizAttemptAnswer[]

  @@index([active])
  @@index([bankId])
}

model QuizAnswer {
  id         String       @id @default(cuid())
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean      @default(false)
  order      Int          @default(0)

  @@index([questionId])
}

// Singleton row (id fixed to "singleton", same idiom as Counter) holding what a
// new question starts from. Everything about how a quiz runs lives on the quiz.
model QuizSettings {
  id                  String   @id
  defaultAnswerCount  Int      @default(4)
  defaultCorrectCount Int      @default(1)
  defaultPoints       Int      @default(10)
  confirmAnswers      Boolean  @default(true)
  updatedAt           DateTime @updatedAt
}

// Singleton row (id fixed to "singleton", same idiom as QuizSettings) holding
// the values the association decides rather than the developer: the fee, the
// contact number members are sent to. Changing one shouldn't need a deploy.
model AppSettings {
  id                String   @id
  membershipFee     Int      @default(100)
  membershipYear    Int?
  supportWhatsapp   String   @default("22241070328")
  tempPasswordHours Int      @default(1)
  whatsappGroup     String?
  secretaryName     String?
  treasurerName     String?
  updatedAt         DateTime @updatedAt
}

model DeletedRecord {
  id        String   @id @default(cuid())
  kind      String
  recordId  String
  label     String
  data      Json
  deletedBy String
  deletedAt DateTime @default(now())
  expiresAt DateTime

  @@index([kind])
  @@index([expiresAt])
}

enum QuizVisibility {
  PUBLIC
  PRIVATE
}

model Competition {
  id                 String              @id @default(cuid())
  name               String
  visibility         QuizVisibility      @default(PUBLIC)
  startsAt           DateTime
  roundCount         Int                 @default(30)
  roundPeriodMinutes Int                 @default(1440)
  roundWindowMinutes Int                 @default(840)
  servedCount        Int                 @default(10)
  categoryRounds     Boolean             @default(false)
  bankId             String              @default("general")
  bank               QuestionBank        @relation(fields: [bankId], references: [id])
  fullSeconds        Int                 @default(10)
  maxSeconds         Int                 @default(30)
  floorPercent       Int                 @default(50)
  rounds             QuizRound[]
  boards             QuizBoard[]
  participants       QuizParticipant[]
  payments           Payment[]
  expenses           Expense[]
  expenseAllocations ExpenseAllocation[]
  donations          Donation[]
  startedAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([bankId])
}

// One ranking a member can look at. blockRounds is how many rounds it covers,
// counting how many of them are added up, and wholeRun says whether it reads
// every block of the run or only the block the open round sits in.
model QuizBoard {
  id            String      @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  title         String
  blockTitle    String      @default("")
  blockRounds   Int         @default(1)
  counting      Int         @default(1)
  wholeRun      Boolean     @default(false)
  order         Int         @default(0)

  @@index([competitionId])
}

model QuizRound {
  id             String              @id @default(cuid())
  competitionId  String
  competition    Competition         @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  index          Int
  category       String?
  opensAt        DateTime
  closesAt       DateTime
  confirmAnswers Boolean?
  announcedAt    DateTime?
  createdAt      DateTime            @default(now())
  questions      QuizRoundQuestion[]
  attempts       QuizAttempt[]

  @@unique([competitionId, index])
  @@index([opensAt])
}

model QuizRoundQuestion {
  id         String       @id @default(cuid())
  roundId    String
  round      QuizRound    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([roundId, questionId])
  @@index([roundId])
}

model QuizAttempt {
  id         String              @id @default(cuid())
  roundId    String
  round      QuizRound           @relation(fields: [roundId], references: [id], onDelete: Cascade)
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt  DateTime            @default(now())
  finishedAt DateTime?
  score      Int                 @default(0)
  voidedAt   DateTime?
  voidedBy   String?
  answers    QuizAttemptAnswer[]

  @@unique([roundId, userId])
  @@index([userId])
}

model QuizAttemptAnswer {
  id                String       @id @default(cuid())
  attemptId         String
  attempt           QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId        String
  question          QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)
  position          Int
  optionOrder       String[]     @default([])
  shownAt           DateTime?
  answeredAt        DateTime?
  selectedAnswerIds String[]     @default([])
  isCorrect         Boolean?
  elapsedMs         Int?
  points            Int          @default(0)

  @@unique([attemptId, position])
  @@index([attemptId])
}

model QuizParticipant {
  id            String      @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([competitionId, userId])
  @@index([userId])
}

enum PaymentPurpose {
  MEMBERSHIP
  DONATION
  ACTIVITY
}

model Payment {
  id            String          @id @default(cuid())
  purpose       PaymentPurpose
  amount        Int
  feeApplied    Int?
  year          Int?
  method        String?
  accountId     String?
  bankReference String?
  account       PaymentAccount? @relation(fields: [accountId], references: [id], onDelete: Restrict)
  proof         String?
  status        ReviewStatus    @default(PENDING)
  anonymous     Boolean         @default(false)
  donorName     String?
  donorPhoto    String? // donor with no linked Member — shown on the honour board
  donorPhone    String? // contact note for a manually entered donor with no account
  userId        String?
  user          User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags          FinanceTag[]
  activityId    String?
  activity      Activity?       @relation(fields: [activityId], references: [id], onDelete: SetNull)
  competitionId String?
  competition   Competition?    @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  recordedBy    String?
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  receipt Receipt?

  @@index([userId, year, purpose])
  @@index([status])
  @@index([activityId])
  @@index([competitionId])
  @@index([accountId])
  @@index([bankReference])
}

enum ReceiptStatus {
  ACTIVE
  VOID
}

model Receipt {
  id         String        @id @default(cuid())
  number     String        @unique
  token      String        @unique
  payerName  String
  reason     String
  amount     Int
  issuedOn   DateTime
  issuedBy   String
  secretary  String?
  treasurer  String?
  status     ReceiptStatus @default(ACTIVE)
  voidReason String?
  voidedAt   DateTime?
  voidedBy   String?
  paymentId  String?       @unique
  payment    Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  userId     String?
  user       User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@index([issuedOn])
}

enum TournamentFormat {
  KNOCKOUT
  GROUPS_THEN_KNOCKOUT
}

// What kind of sport the tournament records. FOOTBALL carries the full
// apparatus (scorers, minutes, cards, man of the match); BOARD is result-only
// (chess, checkers, PlayStation, card games) and those sections never render.
enum SportProfile {
  FOOTBALL
  BOARD
}

enum SuspensionReason {
  RED_CARD
  YELLOW_CARDS
  CONDUCT
}

enum SuspensionScope {
  MATCHES
  DAYS
  INDEFINITE
}

enum SuspensionStatus {
  PROPOSED
  ACTIVE
  LIFTED
}

// A ban scoped to one tournament. Everything starts PROPOSED — the system
// only ever proposes, an admin validates — and MATCHES-scoped bans count
// down as the member's team plays, LIFTED at zero. matches holds what is
// left to serve; until is the DAYS deadline; INDEFINITE ends only by hand.
model Suspension {
  id         String           @id @default(cuid())
  activityId String
  activity   Activity         @relation(fields: [activityId], references: [id], onDelete: Cascade)
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason     SuspensionReason
  scope      SuspensionScope
  matches    Int?
  until      DateTime?
  note       String?
  status     SuspensionStatus @default(PROPOSED)
  createdBy  String
  decidedBy  String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([activityId, userId])
  @@index([activityId, status])
}

model ImportBatch {
  id        String   @id
  fileHash  String
  fileName  String
  rowCount  Int
  createdBy String
  createdAt DateTime @default(now())

  @@index([fileHash])
}
