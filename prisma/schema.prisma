generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id @default(cuid())
  phone             String             @unique
  password          String
  tokenVersion      Int                @default(0)
  createdAt         DateTime           @default(now())
  members           Member[]
  pushSubscriptions PushSubscription[]
  teamFollows       TeamFollow[]
  mvpVotes          MvpVote[]
}

model Member {
  id              String                 @id @default(cuid())
  userId          String
  user            User                   @relation(fields: [userId], references: [id])
  fullName        String
  phone           String
  age             String
  paymentMethod   String
  paymentProof    String?
  photo           String?
  status          String                 @default("PENDING")
  memberNumber    String?                @unique
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  registrations   ActivityRegistration[]
  teamMemberships TeamMember[]
  matchGoals      MatchGoal[]
  matchBookings   MatchBooking[]
  motmMatches     Match[]                @relation("ManOfTheMatch")
  mvpCandidacies  MvpCandidate[]
}

model Activity {
  id            String                 @id @default(cuid())
  title         String
  description   String
  period        String?
  photo         String?
  capacity      Int?
  isOpen        Boolean                @default(true)
  isTournament  Boolean                @default(false)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  registrations ActivityRegistration[]
  teams         Team[]
  matches       Match[]
  groups        Group[]
}

model Group {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime @default(now())
  teams      Team[]

  @@index([activityId])
}

model Team {
  id          String         @id @default(cuid())
  activityId  String
  activity    Activity       @relation(fields: [activityId], references: [id], onDelete: Cascade)
  groupId     String?
  group       Group?         @relation(fields: [groupId], references: [id], onDelete: SetNull)
  name        String
  createdAt   DateTime       @default(now())
  members     TeamMember[]
  homeMatches Match[]        @relation("HomeTeam")
  awayMatches Match[]        @relation("AwayTeam")
  goals       MatchGoal[]
  bookings    MatchBooking[]
  followers   TeamFollow[]

  @@index([activityId])
  @@index([groupId])
}

model TeamFollow {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, teamId])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([teamId, memberId])
}

model Match {
  id              String         @id @default(cuid())
  activityId      String
  activity        Activity       @relation(fields: [activityId], references: [id], onDelete: Cascade)
  homeTeamId      String
  homeTeam        Team           @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeamId      String
  awayTeam        Team           @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Cascade)
  matchDate       DateTime?
  round           String?
  venue           String?
  isKnockout      Boolean        @default(false)
  homeScore       Int?
  awayScore       Int?
  homePenalties   Int?
  awayPenalties   Int?
  manOfTheMatchId String?
  manOfTheMatch   Member?        @relation("ManOfTheMatch", fields: [manOfTheMatchId], references: [id], onDelete: SetNull)
  status          String         @default("SCHEDULED")
  reminderSentAt  DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  goals           MatchGoal[]
  bookings        MatchBooking[]
  mvpVote         MatchMvpVote?

  @@index([activityId])
}

model MatchMvpVote {
  id        String         @id @default(cuid())
  matchId   String         @unique
  match     Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  status    String         @default("OPEN")
  createdAt DateTime       @default(now())
  closedAt  DateTime?
  candidates MvpCandidate[]
  votes      MvpVote[]
}

model MvpCandidate {
  id       String       @id @default(cuid())
  voteId   String
  vote     MatchMvpVote @relation(fields: [voteId], references: [id], onDelete: Cascade)
  memberId String
  member   Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  votes    MvpVote[]

  @@unique([voteId, memberId])
}

model MvpVote {
  id          String       @id @default(cuid())
  voteId      String
  vote        MatchMvpVote @relation(fields: [voteId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   MvpCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())

  @@unique([voteId, userId])
  @@index([candidateId])
}

model MatchBooking {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  cardType  String
  minute    Int?
  createdAt DateTime @default(now())

  @@index([matchId])
}

model MatchGoal {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  count     Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([matchId, memberId])
}

model ActivityRegistration {
  id         String   @id @default(cuid())
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([memberId, activityId])
  @@index([activityId])
}

model Admin {
  id           String    @id @default(cuid())
  username     String    @unique
  password     String
  role         String    @default("SUPER")
  tokenVersion Int       @default(0)
  lastLoginAt  DateTime?
  lastLoginIp  String?
  createdAt    DateTime  @default(now())
}

model Counter {
  id    String @id
  value Int    @default(0)
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model AuditLog {
  id            String   @id @default(cuid())
  adminUsername String
  action        String
  targetLabel   String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
}
