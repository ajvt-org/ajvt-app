# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev-output.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# sqlite (migrated to postgres)
*.db
*.db-journal

# user-uploaded content (member photos, payment proofs) — not source
/public/uploads/*
!/public/uploads/.gitkeep

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# throwaway scripts run against a local database
*.tmp.ts
*.tmp.tsx

# agent tooling, machine-specific
.claude/

# written by `next dev` whenever an AI agent's env is detected. AGENTS.md is
# tracked and already carries the managed block, so the generator finds it
# current and leaves the tree clean. CLAUDE.md is only scaffolded when AGENTS.md
# is missing, so it stays ignored
/CLAUDE.md
